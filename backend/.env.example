# Copy to `.env` or `.env.local` (see ConfigModule in `src/app.module.ts`).

# Required
MONGODB_URI=mongodb://localhost:27017/nassib

# Required in production (`NODE_ENV=production`); must not be `default-secret`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# HTTP server
PORT=3001

# CORS: comma-separated origins (required in production for browser clients)
FRONTEND_ORIGINS=http://localhost:8080

# Socket.IO: production uses this or falls back to FRONTEND_ORIGINS (see `src/websocket/socket-cors.util.ts`)
# WEBSOCKET_CORS_ORIGINS=https://app.example.com

# Throttling (`src/app.module.ts`)
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=120

# Sentry (optional — see `src/sentry.config.ts`)
# SENTRY_DSN=

# Firebase Admin (optional — see `src/firebase/firebase.service.ts`)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccount.json
# Or rely on GOOGLE_APPLICATION_CREDENTIALS

NODE_ENV=development
